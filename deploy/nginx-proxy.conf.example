# VPS: n8n + folder-backup-backend na mesma máquina
#
# Central web:  https://n8n.jediael.uk/
# API (APK/n8n): https://n8n.jediael.uk/webhook/api/v1/...
# APK URL base:  https://n8n.jediael.uk/webhook  (sem /api no final)

# --- Central de controle (6 slots) + arquivos estáticos ---
location / {
    proxy_pass http://127.0.0.1:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Se o n8n já ocupa / no mesmo server_name, use subdomínio ou path dedicado:
# location /control/ {
#     proxy_pass http://127.0.0.1:8080/;
#     ...
# }

# --- API do backend (celular, n8n, central via /webhook/api/) ---
location /webhook/api/ {
    client_max_body_size 500M;
    proxy_pass http://127.0.0.1:8080/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Evolution → backend (configure na instância Evolution):
# POST https://n8n.jediael.uk/webhook/api/v1/webhooks/evolution
# Header: X-Evolution-Secret: <EVOLUTION_WEBHOOK_SECRET>
