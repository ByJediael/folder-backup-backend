# Copie para o painel EasyPanel → Environment (ou arquivo .env na VPS)

PORT=8080
BACKUP_API_TOKEN=troque-por-token-forte

DATA_DIR=/app/data
PUBLIC_BASE_URL=https://backup.jediael.uk

# n8n no mesmo servidor: URL interna do workflow OU webhook público do n8n
N8N_WEBHOOK_URL=https://n8n.jediael.uk/webhook/SEU-UUID-EVENTOS

FCM_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase/serviceAccount.json

# Evolution na VPS (ajuste host se Evolution também está no EasyPanel)
EVOLUTION_ENABLED=true
EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=sua-chave-evolution
EVOLUTION_WEBHOOK_SECRET=segredo-webhook-evolution

EVENTS_MAX_LINES=500
