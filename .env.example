PORT=8080
BACKUP_API_TOKEN=troque-por-um-token-forte

# Onde os dados e uploads ficam no servidor
DATA_DIR=./data

# URL que o celular usa (só informativo nos logs)
# Mesma rede Wi-Fi: http://192.168.0.10:8080
# Público via nginx: https://n8n.jediael.uk/webhook
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Webhook n8n (POST JSON quando eventos acontecem)
# Exemplo: https://n8n.jediael.uk/webhook/backup-events
N8N_WEBHOOK_URL=

# Opcional: URLs específicas por evento (sobrescreve a genérica se definidas)
# N8N_WEBHOOK_JOB_CREATED=
# N8N_WEBHOOK_FILE_UPLOADED=
# N8N_WEBHOOK_JOB_PROGRESS=

# Firebase Cloud Messaging — aciona o APK ao criar job (sem Sincronizar manual)
# FCM_ENABLED=true
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/serviceAccount.json

# Evolution API (proxy no backend — chave nunca no browser)
# EVOLUTION_ENABLED=true
# EVOLUTION_BASE_URL=http://127.0.0.1:8081
# EVOLUTION_API_KEY=
# EVOLUTION_WEBHOOK_SECRET=  # header X-Evolution-Secret no POST /api/v1/webhooks/evolution

# Timeline da central (append-only)
# EVENTS_MAX_LINES=500
