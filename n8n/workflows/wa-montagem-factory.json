      "id": "hero-get-number",
      "name": "Hero SMS getNumber",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data ?? $input.first().json.body ?? '';\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\nlet activationId = '';\nlet phone = '';\nif (text.includes('ACCESS_NUMBER')) {\n  const parts = text.split(':');\n  activationId = parts[1] || '';\n  phone = parts[2] || '';\n}\nif (!phone.startsWith('+')) phone = '+' + phone.replace(/\\D/g, '');\nconst vars = $('Variáveis').first().json;\nreturn [{\n  json: {\n    ...vars,\n    activation_id: activationId,\n    phone_e164: phone,\n    request_id: 'mount-' + Math.random().toString(36).slice(2, 10)\n  }\n}];"
      },
      "id": "parse-number",
      "name": "Parse número Hero",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
