        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"device_id\":\"{{ $json.device_id }}\",\"session_label\":\"{{ $json.session_label }}\",\"evolution_instance\":\"{{ $json.evolution_instance }}\",\"phone_e164\":\"{{ $json.phone_e164 }}\"}"
