    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n// wa_0 representa o estoque do WhatsApp sem redirecionamento\nconst waCount = data.wa_0 ?? data.wa ?? 0;\nreturn [{\n  json: {\n    pais: \"Colômbia (34)\",\n    servico: \"WhatsApp\",\n    numeros_disponiveis: waCount\n  }\n}];"
      },
      "id": "parse-stock",
      "name": "Processar Estoque",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    }
  ],
  "connections": {
