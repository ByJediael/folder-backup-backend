{
  "name": "WhatsApp — limpar sessão (FCM)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "device_id", "name": "device_id", "value": "mi9-se", "type": "string" },
            { "id": "backend_base", "name": "backend_base", "value": "https://backup.jediael.uk", "type": "string" },
            { "id": "backend_token", "name": "backend_token", "value": "12345678", "type": "string" }
          ]
        }
      },
      "id": "set-vars",
      "name": "Variáveis",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_base }}/api/v1/admin/whatsapp/clear",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.backend_token }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"device_id\":\"{{ $json.device_id }}\",\"request_id\":\"n8n-clear-{{ $now.toMillis() }}\"}"
      },
      "id": "clear-wa",
      "name": "Limpar WA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Manual": { "main": [[{ "node": "Variáveis", "type": "main", "index": 0 }]] },
    "Variáveis": { "main": [[{ "node": "Limpar WA", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
