{
  "name": "WhatsApp — trocar sessão (FCM)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "session_label", "value": "numero-timv2" },
            { "name": "device_id", "value": "mi9-se" }
          ]
        }
      },
      "id": "set",
      "name": "Sessão",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.9:8080/api/v1/admin/whatsapp/switch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"device_id\":\"{{ $json.device_id }}\",\"session_label\":\"{{ $json.session_label }}\",\"open_whatsapp\":true}"
      },
      "id": "http",
      "name": "Backend switch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 0],
      "notes": "Mesmo efeito do painel http://192.168.1.9:8080/"
    }
  ],
  "connections": {
    "Manual": { "main": [[{ "node": "Sessão", "type": "main", "index": 0 }]] },
    "Sessão": { "main": [[{ "node": "Backend switch", "type": "main", "index": 0 }]] }
  }
}
