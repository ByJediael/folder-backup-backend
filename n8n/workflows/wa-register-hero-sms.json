      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "device_id", "name": "device_id", "value": "mi9-se", "type": "string" },
            { "id": "session_label", "name": "session_label", "value": "numero-hero-1", "type": "string" },
            { "id": "display_name", "name": "display_name", "value": "Conta Backup", "type": "string" },
            { "id": "hero_api_key", "name": "hero_api_key", "value": "3e6c75e6f74A5cA0f23f5d8575367643", "type": "string" },
            { "id": "hero_service", "name": "hero_service", "value": "wa", "type": "string" },
            { "id": "hero_country", "name": "hero_country", "value": "34", "type": "string" },
            { "id": "backend_base", "name": "backend_base", "value": "https://backup.jediael.uk", "type": "string" },
            { "id": "backend_token", "name": "backend_token", "value": "12345678", "type": "string" }
          ]
        }
      },
      "id": "set-vars",
      "name": "Variáveis",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://hero-sms.com/stubs/handler_api.php?action=getNumberV2&api_key={{ $json.hero_api_key }}&service={{ $json.hero_service }}&country={{ $json.hero_country }}",
        "options": {}
      },
      "id": "hero-get-number",
      "name": "Hero SMS getNumber",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "notes": "Usando getNumberV2 com resposta em formato JSON"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst activationId = response.activationId || '';\nlet phone = response.phoneNumber || '';\nif (phone && !phone.startsWith('+')) {\n  phone = '+' + phone.replace(/\\D/g, '');\n}\nconst vars = $('Variáveis').first().json;\nreturn [{\n  json: {\n    ...vars,\n    activation_id: activationId,\n    phone_e164: phone,\n    request_id: 'reg-' + Math.random().toString(36).slice(2, 10)\n  }\n}];"
      },
      "id": "parse-number",
      "name": "Parse número Hero",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_base }}/api/v1/admin/whatsapp/clear",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.backend_token }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"device_id\":\"{{ $json.device_id }}\"}"
      },
      "id": "clear-wa",
      "name": "Limpar WA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": { "amount": 8, "unit": "seconds" },
      "id": "wait-clear",
      "name": "Aguardar limpar",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Parse número Hero').item.json.backend_base }}/api/v1/admin/whatsapp/register",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Parse número Hero').item.json.backend_token }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"device_id\": \"{{ $('Parse número Hero').item.json.device_id }}\",\n  \"request_id\": \"{{ $('Parse número Hero').item.json.request_id }}\",\n  \"phone_e164\": \"{{ $('Parse número Hero').item.json.phone_e164 }}\",\n  \"session_label\": \"{{ $('Parse número Hero').item.json.session_label }}\",\n  \"display_name\": \"{{ $('Parse número Hero').item.json.display_name }}\"\n}"
      },
      "id": "register-wa",
      "name": "FCM register_whatsapp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "url": "=https://hero-sms.com/stubs/handler_api.php?action=getStatus&api_key={{ $('Parse número Hero').item.json.hero_api_key }}&id={{ $('Parse número Hero').item.json.activation_id }}",
        "options": {}
      },
      "id": "hero-poll",
      "name": "Hero getStatus (poll)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data ?? $input.first().json.body ?? '';\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\nconst m = text.match(/(\\d{6})/);\nconst code = m ? m[1] : '';\nconst prev = $('Parse número Hero').first().json;\nif (!code) throw new Error('Código SMS ainda não chegou: ' + text);\nreturn [{ json: { ...prev, sms_code: code } }];"
      },
      "id": "parse-code",
      "name": "Extrair código",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_base }}/api/v1/admin/whatsapp/register-code",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.backend_token }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"device_id\": \"{{ $json.device_id }}\",\n  \"request_id\": \"{{ $json.request_id }}\",\n  \"code\": \"{{ $json.sms_code }}\"\n}"
      },
      "id": "send-code",
      "name": "FCM código SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 0]
    },
    {
      "parameters": { "amount": 30, "unit": "seconds" },
      "id": "wait-done",
      "name": "Aguardar cadastro",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2200, 0]
    },
    {
      "parameters": {
        "url": "={{ $('Extrair código').item.json.backend_base }}/api/v1/admin/whatsapp/register-status?device_id={{ $('Extrair código').item.json.device_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Extrair código').item.json.backend_token }}" }
          ]
        }
      },
      "id": "poll-status",
      "name": "Status cadastro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 0]
    }
  ],
